{
  "tasks": {
    "dev": "deno run -A --watch --env-file=.env src/main.tsx",
    "warmup": "deno run -A --env-file=.env scripts/warmup.ts",
    "db:init": "deno run -A --env-file=.env scripts/db/init.ts",
    "db:seed": "deno run -A --env-file=.env scripts/db/seed_demo.ts",
    "dev:css": "pnpm exec tailwindcss -c tailwind.config.ts -i ./src/styles/tailwind.css -o ./static/styles.css --watch",
    "build:css": "pnpm exec tailwindcss -c tailwind.config.ts -i ./src/styles/tailwind.css -o ./static/styles.css",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "deploy": "deployctl deploy --project=${DEPLOY_PROJECT:-deno-hono-shop} --entrypoint=src/main.tsx"
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "imports": {
    "hono": "https://deno.land/x/hono@v3.12.0/mod.ts",
    "hono/jsx": "https://deno.land/x/hono@v3.12.0/jsx/index.ts",
    "hono/jsx/jsx-runtime": "https://deno.land/x/hono@v3.12.0/jsx/jsx-runtime.ts",
    "hono/jsx/jsx-dev-runtime": "https://deno.land/x/hono@v3.12.0/jsx/jsx-runtime.ts",
    "hono/middleware": "https://deno.land/x/hono@v3.12.0/middleware.ts",
    "hono/cookie": "https://deno.land/x/hono@v3.12.0/helper/cookie/index.ts",
    "@neondatabase/serverless": "npm:@neondatabase/serverless@0.8.1"
  },
  "deploy": {
    "project": "deno-hono-shop",
    "entrypoint": "src/main.tsx",
    "include": [
      "src",
      "static",
      "deno.json",
      "tailwind.config.ts",
      "package.json",
      "pnpm-lock.yaml"
    ]
  },
  "fmt": {
    "exclude": [
      "static/styles.css"
    ]
  }
}
