{
  "tasks": {
    "dev": "deno run -A --watch --env-file=.env src/main.tsx",
    "warmup": "deno run -A --env-file=.env scripts/warmup.ts",
    "db:init": "deno run -A --env-file=.env scripts/db/init.ts",
    "db:seed": "deno run -A --env-file=.env scripts/db/seed_demo.ts",
    "dev:css": "pnpm exec tailwindcss -i ./src/styles/tailwind.css -o ./static/styles.css --watch",
    "build:css": "pnpm exec tailwindcss -i ./src/styles/tailwind.css -o ./static/styles.css",
    "test": "deno test -A",
    "smoke": "deno run -A --env-file=.env scripts/smoke.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "deploy": "deployctl deploy --project=${DEPLOY_PROJECT:-deno-hono-shop} --entrypoint=src/main.tsx"
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.11.1",
    "hono/jsx": "jsr:@hono/hono@^4.11.1/jsx",
    "hono/jsx/jsx-runtime": "jsr:@hono/hono@^4.11.1/jsx/jsx-runtime",
    "hono/jsx/jsx-dev-runtime": "jsr:@hono/hono@^4.11.1/jsx/jsx-runtime",
    "hono/jsx-renderer": "jsr:@hono/hono@^4.11.1/jsx-renderer",
    "hono/deno": "jsr:@hono/hono@^4.11.1/deno",
    "hono/cookie": "jsr:@hono/hono@^4.11.1/cookie",
    "std/assert": "jsr:@std/assert@^1.0.16",
    "@neondatabase/serverless": "npm:@neondatabase/serverless@1.0.2",
    "stripe": "npm:stripe@20.1.0"
  },
  "deploy": {
    "project": "deno-hono-shop",
    "entrypoint": "src/main.tsx",
    "include": [
      "src",
      "static",
      "deno.json",
      "tailwind.config.ts",
      "package.json",
      "pnpm-lock.yaml"
    ]
  },
  "fmt": {
    "exclude": [
      "static/styles.css"
    ]
  }
}
