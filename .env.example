APP_ENV="development"
PORT=8000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
COOKIE_SECRET="replace-with-strong-secret"

DEPLOY_PROJECT="deno-hono-shop"

